{
  "$comment": "The admin UI's actual current palette (light theme): toolbar base from lib/web/toolbar.ts plus the status/badge families from admin-ui-styles.ts. color + font only. Kept separate from theme-tokens.json, which stays PWA-chrome-only.",
  "color": {
    "bg": { "page": "#f7f7fb", "surface": "#ffffff", "subtle": "#f3f4f6", "muted": "#f9fafb" },
    "border": { "default": "#e8e8ee", "strong": "#d1d5db", "subtle": "#f3f4f6" },
    "text": { "heading": "#1a1a2e", "body": "#374151", "muted": "#6b7280", "faint": "#9ca3af" },
    "brand": { "default": "#4f46e5", "strong": "#4338ca", "bg": "#eef2ff", "border": "#c7d2fe" },
    "primary": { "default": "#1a1a2e", "hover": "#2d2d4e", "text": "#ffffff" },
    "success": { "bg": "#d1fae5", "text": "#065f46", "border": "#a7f3d0" },
